# Supabase — copy to .env and fill with your project values
# Project Settings → API in your Supabase dashboard
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# OpenWeatherMap — free tier. Create a key at https://openweathermap.org/api
EXPO_PUBLIC_OPENWEATHER_KEY=your-openweathermap-key
